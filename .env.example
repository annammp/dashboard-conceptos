# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase.
# .env.local está en .gitignore y no se sube al repo.

# Project URL del proyecto (Supabase > Project Settings > Data API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# La "anon" / publishable key. Es PÚBLICA por diseño: viaja en el bundle del
# navegador y está protegida por las políticas RLS. No es un secreto.
# La key "service_role" NUNCA va aquí ni en ningún archivo del repo.
VITE_SUPABASE_ANON_KEY=

# 'supabase' usa la base real. 'local' guarda en el navegador y no necesita red:
# es el driver de desarrollo y el que usan las pruebas end-to-end.
VITE_DATA_DRIVER=local
